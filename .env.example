# ==========================================
# Voice AI Pipeline Configuration (.env.example)
# ==========================================

# Active Cloud LLM Provider: "groq" | "openai" | "gemini"
LLM_PROVIDER=groq

# ------------------------------------------
# Provider A: Groq (https://console.groq.com/keys)
# ------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------
# Provider B: OpenAI (https://platform.openai.com/api-keys)
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# Provider C: Google Gemini (https://aistudio.google.com/apikey)
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------
# LLM Generation Hyperparameters
# ------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=150

# ------------------------------------------
# ElevenLabs Text-to-Speech (https://elevenlabs.io)
# ------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------
# Server & Port Configuration
# ------------------------------------------
PORT=8001
HOST=0.0.0.0
