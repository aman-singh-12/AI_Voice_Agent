# ==========================================
# Voice AI Pipeline Configuration (.env)
# ==========================================

# Pipeline Mode: "local" (100% Free / Local Ollama, 0 API Keys) or "cloud" (Groq + ElevenLabs)
PIPELINE_MODE=local

# Local Ollama LLM Configuration (Optimized for 8GB RAM Laptops)
OLLAMA_MODEL=qwen2.5:1.5b
LOCAL_VOICE=en-US-JennyNeural

# Cloud Mode: Groq LLM API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloud Mode: ElevenLabs Text-to-Speech API Key & Voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Configuration
PORT=8001
HOST=0.0.0.0
